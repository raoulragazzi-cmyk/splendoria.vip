{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splendoria-v2",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splendoria-v2-test",
      "database_id": "8bf872f6-3f9e-471f-95bc-a99a94f0d97c"
    }
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL"
    }
  ],
  "vars": {
    "APP_URL": "https://splendoria-v2.raoulragazzi.workers.dev",
    "ADMIN_EMAIL": "raoulragazzi@gmail.com",
    "EMAIL_FROM": "contatti@splendoria.vip"
  }
}
