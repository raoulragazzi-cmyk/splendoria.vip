      "preview_database_id": "8bf872f6-3f9e-471f-95bc-a99a94f0d97c"
    }
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL"
    }
  ],
  "vars": {
    "APP_URL": "https://www.splendoria.vip",
    "ADMIN_EMAIL": "raoulragazzi@gmail.com",
    "EMAIL_FROM": "contatti@splendoria.vip"
  }
}
