{
  "name": "splendoria-vip",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 execute splendoria-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute splendoria-db --remote --file=schema.sql",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/gentium-book-plus": "5.3.0",
    "bcryptjs": "3.0.3"
  },
  "devDependencies": {
    "wrangler": "^4.28.1"
  }
}
